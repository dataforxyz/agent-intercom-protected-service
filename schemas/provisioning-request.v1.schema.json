{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dataforxyz:agent-intercom:provisioning-request:v1",
  "title": "provisioning-request.v1",
  "description": "Structural, non-authoritative provisioning request data schema. JSON Schema cannot enforce raw JSON duplicate-key rejection, numeric spelling, or the Rust parser's u64 conversion semantics. The Rust byte parser is mandatory and additionally enforces the 4096-byte limit and canonical output bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "release",
    "request_id",
    "schema_version"
  ],
  "properties": {
    "action": {
      "const": "provision"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "target",
        "version"
      ],
      "properties": {
        "channel": {
          "const": "stable"
        },
        "target": {
          "const": "linux-amd64"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])\\.(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])\\.(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])(?![\\s\\S])"
        }
      }
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
    },
    "schema_version": {
      "const": 1
    }
  }
}
